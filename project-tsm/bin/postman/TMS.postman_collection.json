{
  "info": {
    "name": "TMS - Lab 1 Spring Security",
    "description": "Колекція для захисту Лаб.№1: OIDC (UI не тут, лише JWT), JWT resource server, SecurityFilterChain vs @PreAuthorize.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "keycloakUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "realm",
      "value": "course-realm"
    },
    {
      "key": "clientId",
      "value": "backend-app"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "translatorToken",
      "value": ""
    },
    {
      "key": "editorToken",
      "value": ""
    },
    {
      "key": "projectId",
      "value": "1"
    },
    {
      "key": "textKeyId",
      "value": "1"
    },
    {
      "key": "translationId",
      "value": "1"
    },
    {
      "key": "newProjectId",
      "value": ""
    },
    {
      "key": "ownTranslationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Auth (get JWTs via password grant)",
      "item": [
        {
          "name": "Get token - ADMIN (belialu)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "username",
                  "value": "belialu"
                },
                {
                  "key": "password",
                  "value": "belialu123"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', json.access_token);",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get token - TRANSLATOR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "username",
                  "value": "translator"
                },
                {
                  "key": "password",
                  "value": "translator123"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('translatorToken', json.access_token);",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get token - EDITOR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "username",
                  "value": "editor"
                },
                {
                  "key": "password",
                  "value": "editor123"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('editorToken', json.access_token);",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. CUD Projects (AC1)",
      "item": [
        {
          "name": "GET all projects (public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST create project (ADMIN) -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/projects",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Demo Project\",\"description\":\"created from Postman\",\"sourceLanguage\":\"en\",\"targetLanguage\":\"uk\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('newProjectId', pm.response.json().id);",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT update project (ADMIN) -> 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/projects/{{newProjectId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Demo Project v2\",\"description\":\"updated\",\"sourceLanguage\":\"en\",\"targetLanguage\":\"pl\",\"status\":\"ACTIVE\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE project (ADMIN) -> 204",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/projects/{{newProjectId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Text Keys & Translations",
      "item": [
        {
          "name": "Setup: create fixture project (ADMIN) -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/projects",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Postman fixture {{$timestamp}}\",\"sourceLanguage\":\"en\",\"targetLanguage\":\"uk\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('projectId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST text key (TRANSLATOR) -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{translatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/projects/{{projectId}}/text-keys",
            "body": {
              "mode": "raw",
              "raw": "{\"keyName\":\"demo.key\",\"sourceText\":\"Hello, Sinner.\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('textKeyId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST translation proposal (TRANSLATOR) -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{translatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/text-keys/{{textKeyId}}/translations",
            "body": {
              "mode": "raw",
              "raw": "{\"languageCode\":\"uk\",\"translatedText\":\"Привіт, Грішнику.\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('translationId', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. SecurityFilterChain restriction (AC6)",
      "item": [
        {
          "name": "POST project without token -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/projects",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"X\",\"sourceLanguage\":\"en\",\"targetLanguage\":\"uk\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST project as TRANSLATOR -> 403 (filter chain: ADMIN only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{translatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/projects",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"X\",\"sourceLanguage\":\"en\",\"targetLanguage\":\"uk\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. @PreAuthorize restriction (AC7)",
      "item": [
        {
          "name": "PATCH approve as TRANSLATOR -> 403 (@PreAuthorize: ADMIN/EDITOR only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{translatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/translations/{{translationId}}/approve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH approve as EDITOR -> 200",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{editorToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/translations/{{translationId}}/approve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Ownership: edit/delete own proposal",
      "item": [
        {
          "name": "Propose second translation for ownership tests (TRANSLATOR) -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{translatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/text-keys/{{textKeyId}}/translations",
            "body": {
              "mode": "raw",
              "raw": "{\"languageCode\":\"uk\",\"translatedText\":\"Чернетка перекладу\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('ownTranslationId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT edit own translation (TRANSLATOR) -> 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{translatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/text-keys/{{textKeyId}}/translations/{{ownTranslationId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"languageCode\":\"uk\",\"translatedText\":\"Виправлений переклад\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT edit translation as EDITOR (not owner) -> 403",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{editorToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/text-keys/{{textKeyId}}/translations/{{ownTranslationId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"languageCode\":\"uk\",\"translatedText\":\"Чужий edit\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE own translation (TRANSLATOR) -> 204",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{translatorToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/translations/{{ownTranslationId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Cleanup",
      "item": [
        {
          "name": "Cleanup: delete fixture project (ADMIN) -> 204",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/projects/{{projectId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}